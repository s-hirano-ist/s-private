{
	"servers": {
		"github": {
			"url": "https://api.githubcopilot.com/mcp/",
			"tokenEnv": "GITHUB_MCP_TOKEN"
		},
		"vercel": { "url": "https://mcp.vercel.com" },
		"sentry": { "url": "https://mcp.sentry.dev/mcp" },
		"auth0": {
			"command": "npx",
			"args": ["-y", "@auth0/auth0-mcp-server@0.1.0-beta.19", "run"]
		},
		"cockroachdb-cloud": { "url": "https://cockroachlabs.cloud/mcp" },
		"cloudflare": { "url": "https://mcp.cloudflare.com/mcp" },
		"qdrant-cloud": { "url": "https://api.cloud.qdrant.io/mcp" },
		"backblaze-b2": {
			"command": "npx",
			"args": ["-y", "@backblaze-labs/b2-mcp@0.2.2"],
			"envVars": ["B2_APPLICATION_KEY_ID", "B2_APPLICATION_KEY", "B2_REGION"]
		},
		"doppler": {
			"command": "npx",
			"args": ["-y", "@dopplerhq/mcp-server@1.0.5"],
			"envVars": ["DOPPLER_TOKEN"]
		},
		"huggingface": { "url": "https://huggingface.co/mcp" },
		"xcodebuildmcp": {
			"command": "npx",
			"args": ["-y", "xcodebuildmcp@2.7.0", "mcp"],
			"env": {
				"XCODEBUILDMCP_ENABLED_WORKFLOWS": "simulator,ui-automation,debugging,logging"
			}
		}
	}
}
