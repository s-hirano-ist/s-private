# Local-only development configuration. These values are intentionally public
# and must never be reused by Preview or Production.
LOCAL_DEV_MODE=true
LOCAL_AUTH_EMAIL=developer@local.test
LOCAL_AUTH_PASSWORD=local-development-password
LOCAL_AUTH_NAME="Local Developer"
AUTH_SECRET=local-only-auth-secret-change-is-not-required
BETTER_AUTH_URL=http://localhost:3000

DATABASE_URL=postgresql://root@localhost:26257/defaultdb?sslmode=disable

MINIO_ROOT_USER=local-minio-user
MINIO_ROOT_PASSWORD=local-minio-password

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=knowledge_local
EMBEDDING_URL=http://localhost:3001
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_VECTOR_SIZE=384

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=s-private-local
S3_ACCESS_KEY_ID=local-minio-user
S3_SECRET_ACCESS_KEY=local-minio-password
S3_FORCE_PATH_STYLE=true
