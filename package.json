{
	"name": "s-private",
	"version": "4.2.0",
	"author": "s-hirano-ist",
	"description": "Private pages and admin tools for s-hirano-ist.",
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": "26.x"
	},
	"type": "module",
	"scripts": {
		"dev": "node --env-file=.env.local scripts/local-dev.mjs",
		"dev:app": "pnpm packages:build && node scripts/start-development.mjs",
		"local:down": "docker compose --env-file .env.local --profile local down",
		"build": "pnpm pipeline build --full",
		"packages:build": "pnpm --filter './packages/*' -r run build && pnpm check:publish",
		"clean": "rm -rf apps/web/node_modules apps/web/.next packages/*/node_modules packages/*/dist",
		"format": "vp fmt",
		"format:check": "vp fmt --check .",
		"harness:sync": "node scripts/harness.mjs sync",
		"harness:check": "node scripts/harness.mjs check",
		"lint": "pnpm packages:build && pnpm lint:raw && pnpm lint:colors",
		"lint:colors": "node --test scripts/check-semantic-colors.test.mjs && node scripts/check-semantic-colors.mjs",
		"lint:raw": "vp lint && eslint \"**/*.{yml,yaml,json,jsonc,json5}\"",
		"lint:fix": "pnpm packages:build && pnpm lint:fix:raw",
		"lint:fix:raw": "vp lint --fix && eslint --fix \"**/*.{yml,yaml,json,jsonc,json5}\"",
		"lint:css": "stylelint \"**/*.css\"",
		"lint:css:fix": "stylelint \"**/*.css\" --fix",
		"lint:md": "mise exec -- rumdl check .",
		"lint:md:fix": "mise exec -- rumdl check --fix .",
		"lint:secret": "mise exec -- node scripts/check-secrets.mjs",
		"check:fix": "pnpm format && pnpm lint:fix && pnpm lint:css:fix && pnpm lint:md:fix",
		"check:agent": "pnpm format:check && pnpm api:check && SKIP_ENV_VALIDATION=true pnpm typecheck && SKIP_ENV_VALIDATION=true pnpm lint && pnpm deps:check && pnpm packages:build && pnpm test",
		"bench": "vp test run --project 'bench (bench)'",
		"bench:components": "vp test run --project 'app-bench (bench)'",
		"bench:all": "vp test run --project 'bench (bench)' --project 'app-bench (bench)'",
		"test": "rm -rf .vitest-coverage/blob && STORYBOOK_DISABLE_TELEMETRY=true vitest run --project storybook --reporter=blob --outputFile.blob=.vitest-coverage/blob/storybook.json --coverage.reportsDirectory=.vitest-coverage/storybook && STORYBOOK_DISABLE_TELEMETRY=true vp test run --project api --project backend --project application --project infrastructure --project app --project components --project core --project database --project image-processing --project notification --project scripts --project search --reporter=blob --outputFile.blob=.vitest-coverage/blob/node.json --coverage.reportsDirectory=.vitest-coverage/node && vitest --mergeReports=.vitest-coverage/blob --coverage.reportsDirectory=.vitest-coverage",
		"test:watch": "vp test watch",
		"typecheck": "pnpm packages:build && pnpm -r run typecheck",
		"license:summary": "pnpm licenses list > library-license.txt",
		"license:check": "node scripts/check-licenses.mjs",
		"check:schema-locked": "node scripts/check-schema-locked.mjs",
		"security": "pnpm audit --audit-level=moderate",
		"security:fix": "pnpm audit --fix",
		"security:report": "pnpm audit --json > security-audit.json",
		"jscpd": "jscpd",
		"jscpd:json": "jscpd -r json -o ./jscpd-report",
		"jscpd:summary": "jscpd > jscpd-summary.txt 2>&1 || true",
		"knip": "pnpm packages:build && knip",
		"storybook": "storybook dev -p 6006",
		"storybook:agent": "storybook dev -p 6006 --ci",
		"storybook:build": "pnpm --filter @s-hirano-ist/s-api-client build && pnpm --filter @s-hirano-ist/s-ui build && pnpm storybook:build:raw",
		"storybook:build:raw": "storybook build -o .storybook-static",
		"storybook:ui": "storybook dev -c packages/ui/.storybook -p 6007",
		"storybook:ui:build": "storybook build -c packages/ui/.storybook -o .storybook-ui-static",
		"storybook:ui:test": "vitest run --config vitest.ui-storybook.config.ts",
		"ui-gallery:build": "pnpm storybook:build && pnpm docs:build && pnpm ui-gallery:build:raw",
		"ui-gallery:build:raw": "node scripts/build-ui-gallery.mjs",
		"pages:build": "pnpm ui-gallery:build",
		"deps:check": "pnpm api:generate && depcruise apps/web/src packages/ui packages/core packages/notification packages/api-contracts packages/api-client apps/backend packages/application packages/infrastructure packages/scripts --config dependency-cruiser.config.js",
		"deps:circular": "depcruise apps/web/src packages/ui packages/core packages/notification --config dependency-cruiser.config.js --output-type text --focus-depth 0",
		"deps:graph": "{ echo '```mermaid'; depcruise apps/web/src packages/ui packages/core packages/notification --config dependency-cruiser.config.js --output-type mermaid --collapse 'apps/web/src/(application-services|infrastructures)/[^/]+/|apps/web/src/(app|common|components|loaders)/|packages/core/[^/]+/|packages/(ui|database|notification|search|storage)/' --include-only '^(apps/web/src|packages)/(?!.*(vitest|\\.stories\\.))'; echo '```'; } > dependency-graph.md",
		"prisma:deploy": "pnpm --filter s-database prisma:deploy",
		"prisma:studio": "pnpm --filter s-database prisma:studio",
		"docs:build": "pnpm --filter @s-hirano-ist/s-database build && pnpm docs:build:raw",
		"docs:build:raw": "typedoc && pnpm --filter @s-hirano-ist/s-database docs:build",
		"docs:serve": "npx serve docs/api",
		"docs:watch": "typedoc --watch",
		"docs:clean": "rm -rf docs/api",
		"test:chaos": "playwright test",
		"test:instant-navigation": "playwright test e2e/instant-navigation.spec.ts",
		"test:e2e:main": "playwright test e2e/main-flows.spec.ts",
		"seed:e2e": "pnpm --filter @s-hirano-ist/s-database seed:e2e",
		"test:mutation": "stryker run",
		"test:mutation:core": "stryker run stryker.config.json",
		"preinstall": "npx only-allow pnpm",
		"prepare": "lefthook install",
		"api:generate": "pnpm --filter @s-hirano-ist/s-api-contracts build && node scripts/generate-api.mjs",
		"api:check": "pnpm --filter @s-hirano-ist/s-api-contracts build && node scripts/generate-api.mjs --check",
		"check:publish": "node scripts/check-publish-boundaries.mjs",
		"check:cli-package": "node scripts/verify-cli-package.mjs"
	},
	"dependencies": {
		"next": "catalog:",
		"next-intl": "catalog:"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "5.6.0",
		"@next/playwright": "16.4.5",
		"@playwright/test": "1.65.0",
		"@s-hirano-ist/s-ui": "workspace:*",
		"@secretlint/secretlint-rule-preset-recommend": "13.1.0",
		"@storybook/addon-a11y": "10.6.6",
		"@storybook/addon-docs": "10.6.6",
		"@storybook/addon-mcp": "10.6.6",
		"@storybook/addon-themes": "10.6.6",
		"@storybook/addon-vitest": "10.6.6",
		"@storybook/nextjs-vite": "10.6.6",
		"@stryker-mutator/core": "10.1.1",
		"@stryker-mutator/typescript-checker": "10.1.1",
		"@stryker-mutator/vitest-runner": "10.1.1",
		"@tailwindcss/postcss": "catalog:",
		"@tailwindcss/typography": "catalog:",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@vitest/browser": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"dependency-cruiser": "18.7.2",
		"eslint": "10.14.0",
		"eslint-plugin-jsonc": "3.4.2",
		"eslint-plugin-perfectionist": "5.13.0",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-regexp": "3.3.3",
		"eslint-plugin-sonarjs": "4.2.2",
		"eslint-plugin-storybook": "10.6.6",
		"eslint-plugin-unicorn": "79.0.0",
		"eslint-plugin-yml": "3.10.0",
		"happy-dom": "21.0.4",
		"jscpd": "5.4.2",
		"jsonc-parser": "3.3.1",
		"knip": "6.44.1",
		"lefthook": "catalog:",
		"lint-staged": "17.6.0",
		"oxfmt": "catalog:",
		"oxlint": "1.91.0",
		"oxlint-plugin-eslint": "1.91.0",
		"oxlint-tsgolint": "7.0.2006",
		"playwright": "1.65.0",
		"storybook": "10.6.6",
		"storybook-next-intl": "10.1.4",
		"stylelint": "18.0.0",
		"stylelint-config-standard": "41.0.0",
		"stylelint-declaration-block-no-ignored-properties": "3.0.0",
		"stylelint-no-unsupported-browser-features": "8.1.2",
		"stylelint-order": "8.1.3",
		"tailwindcss": "catalog:",
		"typedoc": "0.28.20",
		"typedoc-plugin-mdn-links": "5.1.1",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"orval": "8.46.0",
		"@s-hirano-ist/s-api-contracts": "workspace:*"
	},
	"private": true
}
