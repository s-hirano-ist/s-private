{
	"name": "s-private-backend",
	"version": "1.0.0",
	"private": true,
	"engines": {
		"node": "26.x"
	},
	"type": "module",
	"scripts": {
		"build": "tsc --noEmit",
		"typecheck": "tsc --noEmit",
		"dev": "tsx watch src/dev.ts",
		"start": "tsx src/dev.ts"
	},
	"dependencies": {
		"@s-hirano-ist/s-core": "workspace:*",
		"@s-hirano-ist/s-database": "workspace:*",
		"better-auth": "1.7.18",
		"zod": "catalog:",
		"jose": "6.2.15",
		"@hono/zod-openapi": "1.6.3",
		"hono": "catalog:",
		"@s-hirano-ist/s-api-contracts": "workspace:*",
		"@sentry/node": "11.11.0",
		"@hono/node-server": "2.1.6",
		"@s-hirano-ist/s-application": "workspace:*",
		"@s-hirano-ist/s-infrastructure": "workspace:*",
		"@s-hirano-ist/s-storage": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"tsx": "4.23.15"
	},
	"exports": {
		"./*": "./src/*.ts"
	}
}
