{
	"threshold": 10,
	"reporters": ["console"],
	"ignore": [
		"**/node_modules/**",
		"apps/web/.next/**",
		"**/dist/**",
		"**/.storybook-static/**",
		"**/coverage/**",
		"**/.vitest-coverage/**",
		"**/*.test.ts",
		"apps/web/src/generated/**"
	],
	"pattern": "**/*.{ts,tsx}",
	"path": ["apps/web/src", "packages/ui", "packages/core"],
	"absolute": true
}
