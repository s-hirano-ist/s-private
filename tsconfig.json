{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": ["DOM", "ES2025"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"paths": {
			"@/*": ["./apps/web/src/*"],
			"@s-hirano-ist/s-core/*": ["./packages/core/*"]
		},
		"jsx": "react-jsx"
	},
	"include": ["apps/web/src/**/*", "packages/*/src/**/*", "packages/*/**/*"],
	"exclude": ["node_modules", ".next", "**/node_modules"]
}
