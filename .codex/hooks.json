{
	"description": "Shared repository validation hook for Codex.",
	"hooks": {
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$(git rev-parse --show-toplevel)/.harness/hooks/check-fix.mjs\"",
						"timeout": 600,
						"statusMessage": "Formatting and validating the repository"
					}
				]
			}
		]
	}
}
