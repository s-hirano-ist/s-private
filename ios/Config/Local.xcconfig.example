// Copy this file to Local.xcconfig. Never commit Local.xcconfig.
IOS_DEVELOPMENT_TEAM = YOUR_TEAM_ID
AUTH0_CLIENT_ID = YOUR_NATIVE_APPLICATION_CLIENT_ID
AUTH0_DOMAIN = YOUR_TENANT.auth0.com
AUTH0_AUDIENCE = https:/$()/YOUR_API_IDENTIFIER
MOBILE_API_BASE_URL = https:/$()/YOUR_APPLICATION_ORIGIN/api/mobile/v1
