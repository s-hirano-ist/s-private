{
	"packages": {
		".": {
			"release-type": "node",
			"component": "s-private",
			"extra-files": [
				{
					"type": "json",
					"path": "packages/scripts/package.json",
					"jsonpath": "$.version"
				}
			]
		},
		"packages/ui": {
			"release-type": "node",
			"component": "@s-hirano-ist/s-ui"
		}
	},
	"plugins": [
		{
			"type": "node-workspace",
			"updateAllPackages": false
		}
	],
	"changelog-sections": [
		{
			"type": "feat",
			"section": "Features"
		},
		{
			"type": "fix",
			"section": "Bug Fixes"
		},
		{
			"type": "revert",
			"section": "Bug Fixes"
		},
		{
			"type": "docs",
			"section": "Documentation"
		},
		{
			"type": "test",
			"section": "Documentation"
		},
		{
			"type": "chore",
			"section": "Maintenance"
		},
		{
			"type": "refactor",
			"section": "Maintenance"
		},
		{
			"type": "style",
			"section": "Maintenance"
		},
		{
			"type": "perf",
			"section": "Maintenance"
		},
		{
			"type": "build",
			"section": "Maintenance"
		},
		{
			"type": "ci",
			"section": "Maintenance"
		}
	]
}
