{
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',
	timezone: 'Asia/Tokyo',
	baseBranchPatterns: [
		'main',
	],
	extends: [
		'config:recommended',
		'config:best-practices',
		':semanticCommitTypeAll(chore)',
		':enableVulnerabilityAlertsWithLabel(security)',
	],
	reviewers: [
		's-hirano-ist',
	],
	enabledManagers: [
		'npm',
		'mise',
		'nvm',
		'docker-compose',
		'github-actions',
	],
	ignoreScripts: true,
	toolSettings: {
		nodeMaxMemory: 4096,
	},
	dependencyDashboard: {
		enabled: true,
	},
	branchConcurrentLimit: 1,
	prConcurrentLimit: 1,
	separateMajorMinor: false,
	separateMinorPatch: false,
	separateMultipleMajor: false,
	schedule: [
		'before 11am on monday',
	],
	labels: [
		'dependencies',
	],
	rangeStrategy: 'bump',
	automerge: false,
	lockFileMaintenance: {
		enabled: false,
	},
	vulnerabilityAlerts: {
		groupName: 'all dependencies',
		groupSlug: 'all-dependencies',
		branchTopic: 'all-dependencies',
		schedule: [
			'at any time',
		],
		labels: [
			'dependencies',
			'security',
		],
	},
	packageRules: [
		{
			matchDatasources: [
				'npm',
			],
			minimumReleaseAge: '1 day',
			internalChecksFilter: 'strict',
		},
		{
			matchPackageNames: [
				'node',
				'@types/node',
			],
			allowedVersions: '26.x',
		},
		{
			matchPackageNames: [
				'node',
			],
			matchDepTypes: [
				'engines',
			],
			rangeStrategy: 'replace',
		},
		{
			matchPackageNames: [
				'typescript',
			],
			allowedVersions: '<7',
		},
		{
			matchDatasources: [
				'docker',
			],
			matchPackageNames: [
				'cockroachdb/cockroach',
			],
			allowedVersions: '/^v26\\.2\\./',
		},
		{
			matchDatasources: [
				'docker',
			],
			matchPackageNames: [
				's0hirano/embedding-api',
			],
			enabled: false,
		},
		{
			matchPackageNames: [
				'*',
			],
			groupName: 'all dependencies',
			groupSlug: 'all-dependencies',
			separateMajorMinor: false,
			separateMinorPatch: false,
			separateMultipleMajor: false,
		},
	],
}
