{
	"name": "@s-hirano-ist/s-image-processing",
	"version": "1.0.0",
	"description": "Shared Sharp-based image processing utilities for s-private",
	"type": "module",
	"exports": {
		"./node": {
			"types": "./src/node.ts",
			"default": "./src/node.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			"./node": {
				"types": "./dist/node.d.ts",
				"default": "./dist/node.js"
			}
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc",
		"prepublishOnly": "pnpm run build",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit"
	},
	"license": "AGPL-3.0",
	"dependencies": {
		"sharp": "0.35.3"
	},
	"devDependencies": {
		"@types/node": "24.13.3",
		"typescript": "7.0.2"
	}
}
