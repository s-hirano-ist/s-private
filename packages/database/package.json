{
	"name": "@s-hirano-ist/s-database",
	"version": "1.21.1",
	"description": "Prisma database schema and client for s-private project",
	"engines": {
		"node": ">=24.20.0"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./generated": {
			"import": "./src/generated/index.js"
		},
		"./generated/*": {
			"import": "./src/generated/*"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./src/index.ts",
				"import": "./src/index.ts"
			},
			"./generated": {
				"import": "./src/generated/index.js"
			},
			"./generated/*": {
				"import": "./src/generated/*"
			}
		}
	},
	"files": [
		"src",
		"prisma",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"prisma:generate": "prisma generate",
		"prisma:migrate:diff": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --script",
		"prisma:deploy": "prisma migrate deploy",
		"prisma:studio": "prisma studio",
		"docs:build": "node scripts/generate-db-docs.mjs",
		"build": "prisma generate && tsc --noEmit",
		"postinstall": "pnpm prisma:generate",
		"prepublishOnly": "pnpm prisma:generate",
		"typecheck": "tsc --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/s-hirano-ist/s-private.git",
		"directory": "packages/database"
	},
	"license": "AGPL-3.0",
	"dependencies": {
		"@prisma/adapter-pg": "7.10.0",
		"@prisma/client": "7.10.0",
		"@prisma/client-runtime-utils": "7.10.0",
		"prisma": "7.10.0"
	},
	"devDependencies": {
		"@types/node": "24.13.3",
		"typescript": "6.0.3"
	}
}
