{
	"name": "@s-hirano-ist/s-storage",
	"version": "2.0.0",
	"description": "S3-compatible object storage for s-private",
	"engines": {
		"node": "26.x"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"minio",
		"storage",
		"typescript"
	],
	"author": "",
	"license": "AGPL-3.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/s-hirano-ist/s-private.git",
		"directory": "packages/storage"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"typescript": "catalog:"
	},
	"private": true
}
