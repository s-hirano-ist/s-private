{
	"name": "@s-hirano-ist/s-ui",
	"version": "2.0.1",
	"description": "Framework-agnostic React 19 design system",
	"type": "module",
	"exports": {
		"./badge": {
			"types": "./dist/badge.d.ts",
			"import": "./dist/badge.js"
		},
		"./button": {
			"types": "./dist/button.d.ts",
			"import": "./dist/button.js"
		},
		"./card": {
			"types": "./dist/card.d.ts",
			"import": "./dist/card.js"
		},
		"./combobox-field": {
			"types": "./dist/combobox-field.d.ts",
			"import": "./dist/combobox-field.js"
		},
		"./dialog": {
			"types": "./dist/dialog.d.ts",
			"import": "./dist/dialog.js"
		},
		"./drawer": {
			"types": "./dist/drawer.d.ts",
			"import": "./dist/drawer.js"
		},
		"./dropdown-menu": {
			"types": "./dist/dropdown-menu.d.ts",
			"import": "./dist/dropdown-menu.js"
		},
		"./empty-state": {
			"types": "./dist/empty-state.d.ts",
			"import": "./dist/empty-state.js"
		},
		"./field": {
			"types": "./dist/field.d.ts",
			"import": "./dist/field.js"
		},
		"./input": {
			"types": "./dist/input.d.ts",
			"import": "./dist/input.js"
		},
		"./label": {
			"types": "./dist/label.d.ts",
			"import": "./dist/label.js"
		},
		"./loading-indicator": {
			"types": "./dist/loading-indicator.d.ts",
			"import": "./dist/loading-indicator.js"
		},
		"./pagination": {
			"types": "./dist/pagination.d.ts",
			"import": "./dist/pagination.js"
		},
		"./popover": {
			"types": "./dist/popover.d.ts",
			"import": "./dist/popover.js"
		},
		"./rating": {
			"types": "./dist/rating.d.ts",
			"import": "./dist/rating.js"
		},
		"./slider": {
			"types": "./dist/slider.d.ts",
			"import": "./dist/slider.js"
		},
		"./stat": {
			"types": "./dist/stat.d.ts",
			"import": "./dist/stat.js"
		},
		"./tabs": {
			"types": "./dist/tabs.d.ts",
			"import": "./dist/tabs.js"
		},
		"./textarea": {
			"types": "./dist/textarea.d.ts",
			"import": "./dist/textarea.js"
		},
		"./toast": {
			"types": "./dist/toast.d.ts",
			"import": "./dist/toast.js"
		},
		"./hooks/use-infinite-scroll": {
			"types": "./dist/hooks/use-infinite-scroll.d.ts",
			"import": "./dist/hooks/use-infinite-scroll.js"
		},
		"./utils/cn": {
			"types": "./dist/utils/cn.d.ts",
			"import": "./dist/utils/cn.js"
		},
		"./utils/haptic": {
			"types": "./dist/utils/haptic.d.ts",
			"import": "./dist/utils/haptic.js"
		},
		"./styles.css": "./dist/styles.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.d.ts",
		"dist/styles.css",
		"README.md",
		"LICENSE"
	],
	"sideEffects": [
		"./dist/styles.css"
	],
	"scripts": {
		"build": "pnpm run build:js && pnpm run build:css",
		"build:js": "tsup",
		"build:css": "tailwindcss -i src/styles.css -o dist/styles.css --minify",
		"dev": "pnpm run \"/^dev:.*/\"",
		"dev:js": "tsup --watch",
		"dev:css": "tailwindcss -i src/styles.css -o dist/styles.css --watch",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:consumer": "tsc -p fixtures/vite/tsconfig.json --noEmit && vite build fixtures/vite",
		"validate:package": "publint && npm_config_cache=/tmp/s-ui-npm-cache attw --pack . --profile esm-only --exclude-entrypoints ./styles.css ./package.json"
	},
	"peerDependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"dependencies": {
		"@base-ui/react": "1.7.0",
		"lucide-react": "1.31.0",
		"tailwind-merge": "3.6.0",
		"tailwind-variants": "3.3.1"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@storybook/react-vite": "10.5.8",
		"@tailwindcss/cli": "4.3.3",
		"@tailwindcss/postcss": "4.3.3",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"publint": "0.3.23",
		"postcss": "8.5.26",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tsup": "8.5.1",
		"typescript": "6.0.3",
		"vite": "7.3.6"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/s-hirano-ist/s-private.git",
		"directory": "packages/ui"
	},
	"keywords": [
		"react",
		"design-system",
		"components",
		"ui"
	],
	"author": "s-hirano-ist",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	}
}
