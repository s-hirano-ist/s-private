{
	"name": "@s-hirano-ist/s-search",
	"version": "1.18.13",
	"description": "RAG search library with Qdrant and embedding API client",
	"engines": {
		"node": ">=24"
	},
	"type": "module",
	"exports": {
		"./config": {
			"types": "./dist/config.d.ts",
			"import": "./dist/config.js"
		},
		"./qdrant-client": {
			"types": "./dist/qdrant-client.d.ts",
			"import": "./dist/qdrant-client.js"
		},
		"./chunker": {
			"types": "./dist/chunker.d.ts",
			"import": "./dist/chunker.js"
		},
		"./ingest": {
			"types": "./dist/ingest.d.ts",
			"import": "./dist/ingest.js"
		},
		"./frontmatter": {
			"types": "./dist/frontmatter.d.ts",
			"import": "./dist/frontmatter.js"
		}
	},
	"files": [
		"src",
		"dist",
		"README.md",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/s-hirano-ist/s-private.git",
		"directory": "packages/search"
	},
	"license": "AGPL-3.0",
	"author": "s-hirano-ist",
	"keywords": [
		"rag",
		"search",
		"qdrant",
		"embedding"
	],
	"publishConfig": {
		"exports": {
			"./config": {
				"types": "./dist/config.d.ts",
				"import": "./dist/config.js"
			},
			"./qdrant-client": {
				"types": "./dist/qdrant-client.d.ts",
				"import": "./dist/qdrant-client.js"
			},
			"./chunker": {
				"types": "./dist/chunker.d.ts",
				"import": "./dist/chunker.js"
			},
			"./ingest": {
				"types": "./dist/ingest.d.ts",
				"import": "./dist/ingest.js"
			},
			"./frontmatter": {
				"types": "./dist/frontmatter.d.ts",
				"import": "./dist/frontmatter.js"
			}
		}
	},
	"scripts": {
		"build": "tsc",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm run build"
	},
	"dependencies": {
		"@qdrant/js-client-rest": "1.19.0",
		"js-yaml": "5.4.1"
	},
	"devDependencies": {
		"@types/node": "24.13.3",
		"typescript": "7.0.2"
	}
}
