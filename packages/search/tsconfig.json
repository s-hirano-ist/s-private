{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"types": ["node"],
		"module": "NodeNext",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"noEmit": false,
		"incremental": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
