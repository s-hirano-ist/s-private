{
	"name": "@s-hirano-ist/s-infrastructure",
	"version": "1.0.0",
	"description": "Shared infrastructure layer for HTTP and CLI hosts",
	"type": "module",
	"engines": {
		"node": ">=24.22.1"
	},
	"exports": {
		"./*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "pnpm clean && tsc",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm run build",
		"clean": "rm -rf dist"
	},
	"license": "AGPL-3.0",
	"dependencies": {
		"@s-hirano-ist/s-application": "workspace:*",
		"@s-hirano-ist/s-core": "workspace:*",
		"@s-hirano-ist/s-database": "workspace:*",
		"@s-hirano-ist/s-search": "workspace:*",
		"zod": "catalog:",
		"@s-hirano-ist/s-image-processing": "workspace:*",
		"@s-hirano-ist/s-notification": "workspace:*",
		"@s-hirano-ist/s-storage": "workspace:*",
		"pino": "10.4.0"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"typescript": "catalog:"
	}
}
