{
	"name": "@s-hirano-ist/s-notification",
	"version": "1.18.5",
	"description": "Notification service for s-private application - Pushover integration",
	"engines": {
		"node": ">=24"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		}
