{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["DOM", "ES2025"],
		"module": "NodeNext",
		"noEmit": false,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": "./",
		"jsx": "preserve",
		"incremental": true
	},
	"include": ["**/*.ts"],
	"exclude": [
		"node_modules",
		"dist",
		"**/*.test.ts",
		"**/*.spec.ts",
		"vitest-setup.tsx",
		"vitest.config.ts"
	]
}
