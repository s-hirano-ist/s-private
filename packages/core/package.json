	"scripts": {
		"build": "pnpm clean && tsc --incremental false",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"domain-driven-design",
		"clean-architecture",
		"typescript",
		"domain-layer"
