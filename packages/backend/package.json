{
	"name": "@s-hirano-ist/s-backend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		"./articles/*": {
			"types": "./src/articles/*.ts",
			"import": "./src/articles/*.ts"
		},
		"./notes/*": {
			"types": "./src/notes/*.ts",
			"import": "./src/notes/*.ts"
		},
		"./shared/*": {
			"types": "./src/shared/*.ts",
			"import": "./src/shared/*.ts"
		},
		"./images/*": {
			"types": "./src/images/*.ts",
			"import": "./src/images/*.ts"
		},
		"./books/*": {
			"types": "./src/books/*.ts",
			"import": "./src/books/*.ts"
		},
		"./mobile/*": {
			"types": "./src/mobile/*.ts",
			"import": "./src/mobile/*.ts"
		},
		"./search/*": {
			"types": "./src/search/*.ts",
			"import": "./src/search/*.ts"
		},
		"./auth/*": {
			"types": "./src/auth/*.ts",
			"import": "./src/auth/*.ts"
		},
		"./observability/*": {
			"types": "./src/observability/*.ts",
			"import": "./src/observability/*.ts"
		},
		"./events/*": {
			"types": "./src/events/*.ts",
			"import": "./src/events/*.ts"
		},
		"./notifications/*": {
			"types": "./src/notifications/*.ts",
			"import": "./src/notifications/*.ts"
		},
		"./api/*": {
			"types": "./src/api/*.ts",
			"import": "./src/api/*.ts"
		}
	},
	"scripts": {
		"build": "tsc --noEmit",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@s-hirano-ist/s-core": "workspace:*",
		"@s-hirano-ist/s-database": "workspace:*",
		"@s-hirano-ist/s-image-processing": "workspace:*",
		"@s-hirano-ist/s-notification": "workspace:*",
		"@s-hirano-ist/s-storage": "workspace:*",
		"better-auth": "1.7.7",
		"zod": "catalog:",
		"@s-hirano-ist/s-search": "workspace:*",
		"jose": "6.2.12",
		"pino": "10.4.0",
		"@hono/zod-openapi": "1.6.3",
		"hono": "catalog:",
		"@s-hirano-ist/s-api-contracts": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"typescript": "catalog:"
	}
}
